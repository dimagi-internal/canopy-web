---
import Mark from './Mark.astro'
import { GITHUB_URL, SIGN_IN_URL } from '../site'
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Canopy home">
      <Mark class="brand-mark" />
      <span class="brand-name">canopy</span>
      <span class="brand-by">by Dimagi</span>
    </a>
    <nav class="nav" aria-label="Site">
      <a class="hide-sm" href="/how-it-works">How it works</a>
      <a class="hide-sm" href={GITHUB_URL}>GitHub</a>
      <a href={SIGN_IN_URL}>Sign in</a>
      <button class="btn btn-primary" type="button" data-beta-open>Request access</button>
    </nav>
  </div>
</header>
