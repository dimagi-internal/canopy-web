SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
DATABASE_URL=postgres://localhost:5432/canopy_web
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Backend: "api" (direct Anthropic SDK) or "cli" (claude code CLI)
AI_BACKEND=api

# Required if AI_BACKEND=api
ANTHROPIC_API_KEY=sk-ant-your-key-here

# If AI_BACKEND=cli, the `claude` binary must be on PATH.
# No API key needed — uses Claude Code's own authentication.

# Google OAuth (django-allauth)
# Create a Web application OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs should include:
#   http://localhost:8000/accounts/google/login/callback/
#   https://<prod-domain>/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email domain allowlist for Google login (comma-separated). Empty = allow any Google account.
AUTH_ALLOWED_EMAIL_DOMAIN=dimagi.com,dimagi-ai.com,dimagi-associate.com

# Whether LoginRequiredMiddleware enforces auth. Set False during local rollout only.
REQUIRE_AUTH=True

# Web Push (VAPID). Empty = push disabled (endpoints 503, nothing sends).
# Public key ships in the JS bundle (not secret); private key signs sends and
# must never leave the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jjackson@dimagi.com

# --- GitHub App (optional; agent creation creates a real repo) ---------------
# Without these, /settings shows "GitHub is not set up on this deployment" and
# everything else works — it is a real state, not a broken one.
# The client id and slug are public (the id is in every authorize URL); only
# the secret is a secret. Register an app at
# https://github.com/settings/apps/new with callback
# http://localhost:8000/auth/github/callback/ for local dev.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
